      {
        "cmd": "date",
        "desc": "Current date and time"
      },
      {
        "cmd": "date +%F",
        "desc": "Date as YYYY-MM-DD"
      },
      {
        "cmd": "date -d tomorrow",
        "desc": "Tomorrow's date"
      },
      {
        "cmd": "date +%s",
        "desc": "Seconds since 1970 (Unix time)"
      }
    ],
    "protip": "Use 'date +%F' in file names for sortable dates like 2026-10-16!"
  },
  {
