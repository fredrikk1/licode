[
  {
    "name": "alias",
    "description": "Create shortcuts - custom abbreviations for long commands.",
    "examples": [
      {
        "cmd": "alias ll='ls -la'",
        "desc": "Create shortcut"
      },
      {
        "cmd": "alias ..='cd ..'",
        "desc": "Quick navigation"
      },
      {
        "cmd": "alias grep='grep --color=auto'",
        "desc": "Colorize grep"
      },
      {
        "cmd": "alias update='sudo apt update && sudo apt upgrade'",
        "desc": "Combo command"
      }
    ],
    "protip": "Add to ~/.bashrc to make aliases permanent!"
  },
  {
    "name": "awk",
    "description": "Text processing - extracts and manipulates columns of data.",
    "examples": [
      {
        "cmd": "awk '{print $1}' file.txt",
        "desc": "Print first column"
      },
      {
        "cmd": "awk -F: '{print $1}' /etc/passwd",
        "desc": "Extract usernames"
      },
      {
        "cmd": "awk 'NR>1 {sum+=$3} END {print sum}' data.txt",
        "desc": "Sum column 3"
      }
    ],
    "protip": "Use '-F,' for comma-separated files and 'NR>1' to skip the header line!"
  },
  {
    "name": "basename",
    "description": "Strip the path - leaves just the file name, optionally without suffix.",
    "examples": [
      {
        "cmd": "basename /var/log/syslog",
        "desc": "File name only"
      },
      {
        "cmd": "basename photo.jpg .jpg",
        "desc": "Remove the suffix too"
      },
      {
        "cmd": "dirname /var/log/syslog",
        "desc": "Folder part only"
      },
      {
        "cmd": "realpath file.txt",
        "desc": "Full absolute path"
      }
    ],
    "protip": "Great in loops: 'for f in *.png; do echo \"$(basename \"$f\" .png)\"; done'!"
  },
  {
    "name": "cat",
    "description": "Concatenate and display files - shows file contents in terminal.",
    "examples": [
      {
        "cmd": "cat file.txt",
        "desc": "Display file contents"
      },
      {
        "cmd": "cat file1.txt file2.txt > combined.txt",
        "desc": "Merge files"
      },
      {
        "cmd": "cat -n file.txt",
        "desc": "Show with line numbers"
      },
      {
        "cmd": "cat file.txt | grep error",
        "desc": "View and search"
      }
    ],
    "protip": "Use 'cat file1.txt file2.txt > merged.txt' to combine files!"
  },
  {
    "name": "cd",
    "description": "Change directory - move between folders in your terminal.",
    "examples": [
      {
        "cmd": "cd ~/Documents",
        "desc": "Go to Documents folder"
      },
      {
        "cmd": "cd ..",
        "desc": "Go up one level"
      },
      {
        "cmd": "cd -",
        "desc": "Jump back to previous directory"
      },
      {
        "cmd": "cd /var/log",
        "desc": "Go to absolute path"
      },
      {
        "cmd": "cd ../../",
        "desc": "Go up two levels"
      }
    ],
    "protip": "Just 'cd' with no path takes you home. Use 'cd -' to jump back to previous folder!"
  },
  {
    "name": "chgrp",
    "description": "Change group ownership - set which group owns files and folders.",
    "examples": [
      {
        "cmd": "chgrp staff file.txt",
        "desc": "Change group"
      },
      {
        "cmd": "sudo chgrp -R www-data /var/www",
        "desc": "Change recursively"
      },
      {
        "cmd": "ls -l file.txt",
        "desc": "Check the group column"
      }
    ],
    "protip": "Combine with 'chmod g+s dir' so new files inherit the group!"
  },
  {
    "name": "chmod",
    "description": "Change file permissions - controls who can read/write/execute files.",
    "examples": [
      {
        "cmd": "chmod 755 script.sh",
        "desc": "Make executable for all"
      },
      {
        "cmd": "chmod u+x file.sh",
        "desc": "Add execute for owner"
      },
      {
        "cmd": "chmod -R a+rX folder/",
        "desc": "Make folder readable recursively"
      },
      {
        "cmd": "chmod go-w file.txt",
        "desc": "Remove write for group/others"
      }
    ],
    "protip": "755 = rwxr-xr-x. Use 'chmod +x script.sh' for executables!"
  },
  {
    "name": "chown",
    "description": "Change file owner - transfers ownership of files.",
    "examples": [
      {
        "cmd": "sudo chown user:group file.txt",
        "desc": "Change owner and group"
      },
      {
        "cmd": "sudo chown -R www-data:www-data /var/www",
        "desc": "Web server ownership"
      },
      {
        "cmd": "sudo chown user file.txt",
        "desc": "Change only owner"
      }
    ],
    "protip": "Use 'chown -R user:group folder/' to change entire directories!"
  },
  {
    "name": "cp",
    "description": "Copy files and directories - creates duplicates while keeping originals.",
    "examples": [
      {
        "cmd": "cp file.txt backup.txt",
        "desc": "Copy a file"
      },
      {
        "cmd": "cp -r folder/ backup/",
        "desc": "Copy entire folder"
      },
      {
        "cmd": "cp -p file.conf file.bak",
        "desc": "Preserve timestamps/permissions"
      },
      {
        "cmd": "cp *.jpg ~/Pictures/",
        "desc": "Copy all images"
      }
    ],
    "protip": "Use 'cp -u' to only copy newer files - saves time on big backups!"
  },
  {
    "name": "crontab",
    "description": "Schedule recurring jobs - run commands automatically at set times.",
    "examples": [
      {
        "cmd": "crontab -e",
        "desc": "Edit your scheduled jobs"
      },
      {
        "cmd": "crontab -l",
        "desc": "List your jobs"
      },
      {
        "cmd": "0 3 * * * /path/to/backup.sh",
        "desc": "Line: every night at 03:00"
      },
      {
        "cmd": "*/5 * * * * /path/to/cmd",
        "desc": "Line: every 5 minutes"
      }
    ],
    "protip": "Use crontab.guru to double-check your schedule syntax!"
  },
  {
    "name": "curl",
    "description": "Transfer data from servers - download files and test APIs.",
    "examples": [
      {
        "cmd": "curl https://example.com",
        "desc": "Fetch webpage"
      },
      {
        "cmd": "curl -O https://site.com/file.zip",
        "desc": "Download file"
      },
      {
        "cmd": "curl -X POST -d 'data' api.com",
        "desc": "Send POST request"
      },
      {
        "cmd": "curl -I website.com",
        "desc": "Show headers only"
      }
    ],
    "protip": "Use 'curl -I' to show just headers. 'curl -L' follows redirects!"
  },
  {
    "name": "cut",
    "description": "Cut out columns - extract fields or characters from each line.",
    "examples": [
      {
        "cmd": "cut -d, -f1 data.csv",
        "desc": "First column of a CSV"
      },
      {
        "cmd": "cut -d: -f1,7 /etc/passwd",
        "desc": "Users and their shells"
      },
      {
        "cmd": "cut -c1-10 file.txt",
        "desc": "First 10 characters per line"
      },
      {
        "cmd": "cut -f2 data.tsv",
        "desc": "Second tab-separated field"
      }
    ],
    "protip": "Use 'cut -d: -f1 /etc/passwd' to list every user on the system!"
  },
  {
