    "description": "Current user - prints the user name you are running as.",
    "examples": [
      {
        "cmd": "whoami",
        "desc": "Show your user name"
      },
      {
        "cmd": "sudo whoami",
        "desc": "Shows root"
      },
      {
        "cmd": "who",
        "desc": "Everyone logged in"
      }
    ],
    "protip": "Handy in scripts to refuse running as root by mistake!"
  },
  {
    "name": "xargs",
    "description": "Build commands from input - turns lines of input into arguments.",
    "examples": [
      {
        "cmd": "find . -name '*.log' -print0 | xargs -0 rm",
        "desc": "Delete found files"
      },
      {
        "cmd": "find . -name '*.txt' -print0 | xargs -0 wc -l",
        "desc": "Count lines in found files"
      },
      {
        "cmd": "cat urls.txt | xargs -n1 curl -O",
        "desc": "Download each URL"
      },
      {
        "cmd": "echo a b c | xargs -n1",
        "desc": "One argument per line"
      }
    ],
    "protip": "Use 'find ... -print0 | xargs -0' so filenames with spaces work!"
  },
  {
    "name": "zip",
    "description": "Create zip archives - works on all operating systems.",
    "examples": [
      {
        "cmd": "zip archive.zip file1.txt file2.txt",
        "desc": "Create zip"
      },
      {
        "cmd": "zip -r folder.zip folder/",
        "desc": "Zip entire folder"
      },
      {
        "cmd": "zip -e secure.zip file.txt",
        "desc": "Password-protect (weak)"
      },
      {
        "cmd": "zip -9 compressed.zip file.txt",
        "desc": "Maximum compression"
      }
    ],
    "protip": "Use 'zip -e' to create password-protected archives!"
  }
]